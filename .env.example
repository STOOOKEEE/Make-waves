XRPL_WSS_URL=wss://xrplcluster.com
# SourceTag du projet, déclaré à l'orga du hackathon (entier).
TIDE_SOURCE_TAG=0

# --- Xaman (XUMM SDK) ---
XUMM_API_KEY=
XUMM_API_SECRET=

# --- Feed de prix CEX ---
# Base URL de l'API de prix de référence (ex. CoinGecko).
PRICE_API_URL=https://api.coingecko.com/api/v3
