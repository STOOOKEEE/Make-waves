# Valeurs publiques intégrées au build Vite : ne jamais y placer de secret.
# Plausible reste inactif si VITE_PLAUSIBLE_SCRIPT_URL est absente.
VITE_API_BASE=https://api.tidetrade.xyz

# --- Compte Tide : email magic-link + connexion X via Supabase Auth ---
# Valeurs publiques du projet Supabase (Settings > API). Ne jamais utiliser ici
# la service_role key. Sans ces deux valeurs, le bouton de connexion reste OFF.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Plausible Cloud : script public du site TideTrade. Il est aussi la valeur
# par défaut du build, donc ces deux lignes sont facultatives.
VITE_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/pa-X7OX-EF-u2mc1ml-3SlB6.js

# Instance auto-hébergée : remplace les deux URLs ci-dessus, par exemple :
# VITE_PLAUSIBLE_SCRIPT_URL=https://analytics.tidetrade.xyz/js/script.js
# VITE_PLAUSIBLE_ENDPOINT=https://analytics.tidetrade.xyz/api/event
