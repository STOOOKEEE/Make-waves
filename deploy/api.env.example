# Secrets backend Tide (prod). Copier en deploy/api.env sur le serveur, remplir.
# NE JAMAIS commit api.env réel (gitignore le couvre via **/.env / **/.env.*).
#
# Mode démo (paper + agent) : seule TIDE_LLM_API_KEY est nécessaire pour l'agent.
# Live/mainnet (swaps taggés) : ajouter XRPL_WSS_URL + XUMM_* pour activer.

# --- Agent IA (DeepSeek, endpoint Anthropic-compatible) ---
TIDE_LLM_API_KEY=
TIDE_LLM_BASE_URL=https://api.deepseek.com/anthropic
TIDE_LLM_MODEL=deepseek-v4-flash

# --- Attribution / mainnet (optionnel en démo) ---
TIDE_SOURCE_TAG=2606210009
# XRPL_WSS_URL=wss://s1.ripple.com   # active le Live on-chain quand présent

# --- Xaman/XUMM (optionnel en démo, requis pour signature Live) ---
# XUMM_API_KEY=
# XUMM_API_SECRET=

# --- Prize pool (optionnel) ---
# TIDE_PRIZE_POOL_ADDRESS=

# --- Badges NFT (optionnel) ---
# Sans TIDE_NFT_ISSUER_SEED (+ XRPL_WSS_URL + TIDE_SOURCE_TAG), les badges
# restent off-chain ; /nft-metadata reste servi. Le claim on-chain s'active
# quand les trois sont présents.
# TIDE_NFT_ISSUER_SEED=
# URL publique du backend (base des URI de métadonnées NFT ; défaut localhost:3000)
# TIDE_PUBLIC_BASE_URL=https://api.tidetrade.xyz

# --- Arène de simulation / banc de charge Paper (OFF par défaut) ---
# TIDE_SIMULATION_USERS=300
# TIDE_SIMULATION_TRADES_PER_TICK=12
# TIDE_SIMULATION_TICK_MS=60000

# --- Wallet custodial automatique : adresse à l'arrivée, funding au premier trade ---
# Mainnet exclusivement. Les seeds appartiennent à des comptes dédiés, jamais au wallet maître.
# TIDE_PAPER_WALLET_WSS_URL=wss://xrplcluster.com
# TIDE_PAPER_WALLET_SOURCE_TAG=2606210009
# TIDE_PAPER_WALLET_ISSUER_SEED=<seed du compte issuer Mainnet dédié>
# TIDE_PAPER_WALLET_FUNDER_SEED=<seed du hot funder Mainnet dédié et plafonné>
# TIDE_PAPER_WALLET_KEY_MASTER=<nouvelle clé AES de 64 hex, sauvegardée hors serveur>
# TIDE_PAPER_WALLET_KEY_ID=paper-prod-mainnet-v1
# TIDE_PAPER_WALLET_MAINNET_ACK=I_UNDERSTAND_THIS_SPENDS_REAL_XRP
# TIDE_PAPER_WALLET_RECOVERY_ADDRESS=<adresse Mainnet froide de récupération>
# TIDE_PAPER_WALLET_MAX_WALLETS=160
# TIDE_PAPER_WALLET_MAX_DAILY=25
# TIDE_PUBLIC_BASE_URL=https://api.tidetrade.xyz
# TIDE_FIRST_TRADE_IMAGE_URI=ipfs://bafy.../first-trade.png

# --- Console opérateur privée ---
# Le port 3101 est publié par Docker uniquement sur 127.0.0.1 du serveur.
# TIDE_ADMIN_TOKEN=<secret aléatoire de 32 caractères minimum>
# TIDE_PRIVATE_ADMIN_PORT=3101
