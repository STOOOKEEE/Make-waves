# Secrets backend Tide (prod). Copier en deploy/api.env sur le serveur, remplir.
# NE JAMAIS committer le api.env réel (gitignore le couvre).
#
# ════════════════════════════════════════════════════════════════════
# MODE MAINTENANT « 300 WALLETS COMPTABILISÉS » (Make Waves XRPL)
# Stack minimale pour que chaque user paper → 1 vrai wallet XRPL financé
# → 1 NFT accepté (tx taggée, Account = wallet dédié) = 1 compte actif.
# Les 3 blocs (attribution + wallets paper + badges) sont à remplir.
# ════════════════════════════════════════════════════════════════════

# --- Agent IA (DeepSeek, endpoint Anthropic-compatible) ---
TIDE_LLM_API_KEY=
TIDE_LLM_BASE_URL=https://api.deepseek.com/anthropic
TIDE_LLM_MODEL=deepseek-v4-flash

# --- Attribution / mainnet (REQUIS — tag réservé du hackathon) ---
TIDE_SOURCE_TAG=2606210009
# Nœud mainnet : active client on-chain + indexeur + issuers NFT.
XRPL_WSS_URL=wss://xrplcluster.com
# Comptes à scanner par l'indexeur d'attribution (route /metrics) : prize pool,
# issuer, funder + wallets Live connus. Sépare par virgule. Optionnel.
# TIDE_INDEXED_ACCOUNTS=rPrizePool...,rIssuer...,rFunder...
# TIDE_ATTRIBUTION_DB_PATH=tide-attribution.db

# --- Session (REQUIS — Sign-In with XRPL, garde d'auth global) ---
# Sans ce secret, l'API REFUSE DE DÉMARRER (l'auth est obligatoire sur cette
# branche). 32 caractères minimum. TIDE_SESSION_TTL optionnel (défaut 24 h).
TIDE_SESSION_SECRET=<À_REMPLIR: secret HMAC ≥ 32 caractères>
# TIDE_SESSION_TTL=86400

# --- Email / OAuth social (optionnel) — même projet Supabase que le front ---
# TIDE_AUTH_SUPABASE_URL=https://<project-ref>.supabase.co
# TIDE_AUTH_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Xaman/XUMM (REQUIS pour le login Xaman + claim badge Xaman + swap Live) ---
# Sans ces clés, POST /sign/connect et /sign/status/:uuid ne sont PAS montés
# → le login Xaman renvoie 404 « Mode Live non configuré (clés XUMM manquantes) ».
XUMM_API_KEY=<À_REMPLIR: clé API XUMM>
XUMM_API_SECRET=<À_REMPLIR: secret XUMM>

# --- Badges NFT — claim manuel signé par le USER (wallet connecté) ---
# Issuer DÉDIÉ (jamais le wallet-maître, jamais le funder). Avec XRPL_WSS_URL
# + TIDE_SOURCE_TAG ci-dessus, POST /badges/:code/claim passe de 503 à 201.
# Si le runtime Paper est actif, son issuer/source tag dédiés servent de repli
# au claim First Trade externe lorsque ces variables génériques sont absentes.
# TIDE_NFT_ISSUER_SEED=<seed du compte issuer Mainnet dédié>
# URL publique du backend (base des URI de métadonnées NFT).
TIDE_PUBLIC_BASE_URL=https://api.tidetrade.xyz

# --- Funnel custodial à deux wallets : compte actif + NFT (option A) ---
# Claim 1 : le funder verse 2,22 XRP au wallet 1 et débloque le trading Paper.
# Premier trade : éligibilité seulement, sans transaction XRPL automatique.
# Claim 2 : le wallet 1 verse 1.21 XRP au wallet 2, qui accepte le NFT taggé.
# → chemin vérifiable funder → wallet 1 → wallet 2. Mainnet exclusivement.
# Les seeds appartiennent à des comptes dédiés, jamais au wallet maître.
TIDE_PAPER_WALLET_WSS_URL=wss://xrplcluster.com
TIDE_PAPER_WALLET_SOURCE_TAG=2606210009
# TIDE_PAPER_WALLET_ISSUER_SEED=<seed du compte issuer Mainnet dédié>
# TIDE_PAPER_WALLET_FUNDER_SEED=<seed du hot funder Mainnet dédié et plafonné>
# TIDE_PAPER_WALLET_KEY_MASTER=<nouvelle clé AES de 64 hex, sauvegardée hors serveur>
TIDE_PAPER_WALLET_KEY_ID=paper-prod-mainnet-v1
TIDE_PAPER_WALLET_MAINNET_ACK=I_UNDERSTAND_THIS_SPENDS_REAL_XRP
# TIDE_PAPER_WALLET_RECOVERY_ADDRESS=<adresse Mainnet froide de récupération>
# Plafonds : 300+ utilisateurs au total (objectif hackathon), 50/jour pour tenir
# le calendrier (~6 jours de funding, 2,22 XRP versés par user + frais).
TIDE_PAPER_WALLET_MAX_WALLETS=300
TIDE_PAPER_WALLET_MAX_DAILY=50
# TIDE_FIRST_TRADE_IMAGE_URI=ipfs://bafy.../first-trade.png

# --- Prize pool (buy-ins de compétition Live) — optionnel ---
# TIDE_PRIZE_POOL_ADDRESS=

# --- Console opérateur privée ---
# Le port 3101 est publié par Docker uniquement sur 127.0.0.1 du serveur.
# TIDE_ADMIN_TOKEN=<secret aléatoire de 32 caractères minimum>
TIDE_PRIVATE_ADMIN_PORT=3101
# Facultatif : le conteneur utilise /app/apps/web/dist-admin par défaut.
# TIDE_PRIVATE_ADMIN_UI_DIR=/app/apps/web/dist-admin
# Le wallet personnel connecté suit l'option B : un premier trade Paper rend
# le claim First Trade disponible sur cette adresse ; l'acceptation est signée
# dans Xaman/GemWallet. Aucun OfferCreate auto-généré ne fabrique du volume.
